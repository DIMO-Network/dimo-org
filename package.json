{
  "name": "dimo-developer-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "prebuild": "node scripts/generate-llms-full.mjs && node scripts/generate-mcp-index.mjs",
    "test": "node --test 'scripts/**/*.test.mjs' 'api/**/*.test.mjs' 'api/**/*.test.ts'",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,md,json,css}\"",
    "format:docs": "prettier --write \"docs/**/*.md\" \"blog/**/*.md\"",
    "check-all": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/basic-setup": "^0.20.0",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.15",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@mdx-js/react": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vercel/analytics": "^1.6.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "graphql": "^16.12.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "openai": "^7.5.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-github-btn": "^1.4.0",
    "react-leaflet": "^5.0.0",
    "react-medium-image-zoom": "^5.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.34.0",
    "eslint-plugin-mdx": "^3.6.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "~6.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "websocket-driver": "0.7.5",
    "shell-quote": "^1.12.0",
    "tinypool": "^2.2.0",
    "serialize-javascript": "^7.1.4",
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "unified-engine": {
      "glob": "^14.0.4"
    },
    "mermaid": {
      ".": "^11.17.2",
      "katex": "^0.18.2"
    }
  }
}
